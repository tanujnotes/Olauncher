<?xml version="1.0" encoding="utf-8"?>
<!-- One page's content, inflated per-item by HomePagerAdapter. Pages are fully independent
     (plan.md). The date/time header and screen-time label used to live here as fixed chrome
     (see history.md Step 7) - Date & Screen Time is now a DATE_TIME GridItem rendered inside
     HomeGridView like any other item (Step 10), not fixed per-page chrome. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- One HomeGridView per page, showing that page's items - see
         HomeFragment.bindPage()/populateHomeGrid(). HomeGridView positions cells from its own
         top-left corner and ignores its own padding, so the space around the grid is set here.

         Horizontal is deliberately wider than portrait's 8dp: in landscape this is the edge the
         display cutout and the rounded corners live on. Any width left over beyond the last whole
         cell is split between both sides by HomeGridView itself (gridOffsetX).
         Vertical: unlike portrait, this was never a large fixed reservation for the old header
         (Step 7) - the header's compact landscape content just overlaid this same small margin.
         Left as-is: already the "minimum breathing room" this margin is meant to be. -->
    <app.elauncher.ui.HomeGridView
        android:id="@+id/homeGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="@dimen/home_app_padding_vertical" />
</FrameLayout>
