<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <TextView
        android:id="@+id/appsHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_drawer_search_margin"
        android:layout_marginBottom="6dp"
        android:accessibilityHeading="true"
        android:background="@drawable/bg_drawer_search_white"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingHorizontal="10dp"
        android:text="@string/drawer_apps"
        android:textColor="#101010"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_drawer_apps_badge" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/app_drawer_side_inset"
        android:layout_marginEnd="@dimen/app_drawer_side_inset"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical" />

    <TextView
        android:id="@+id/contactsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/drawer_contacts_empty"
        android:textColor="#FAFAFA"
        android:visibility="gone" />

    <TextView
        android:id="@+id/appRename"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/app_drawer_search_margin"
        android:paddingVertical="@dimen/app_padding_vertical"
        android:text="@string/rename"
        android:textAllCaps="true"
        android:visibility="gone" />

    <include
        android:id="@+id/categoryMenu"
        layout="@layout/app_drawer_category_menu" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_drawer_search_margin"
        android:layout_marginEnd="@dimen/app_drawer_search_margin"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_drawer_search"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/searchLeadingIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_drawer_search" />

        <ImageButton
            android:id="@+id/contactCommandChip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_contact_command_chip"
            android:padding="12dp"
            android:visibility="gone" />

        <app.olauncher.ui.CommandSearchEditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:cursorVisible="true"
            android:hint="@string/search_anything"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="textCapSentences|textNoSuggestions"
            android:maxLength="200"
            android:minHeight="42dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:textColor="#202020"
            android:textColorHint="#414143"
            android:textCursorDrawable="@drawable/cursor_drawer_search"
            android:textDirection="locale"
            android:textSize="16sp"
            android:theme="@style/DrawerSearchInput" />

        <View
            android:id="@+id/searchDivider"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="#F5F5F5"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/searchLegacyRail"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_drawer_search_rail"
            android:importantForAccessibility="no"
            android:paddingStart="4dp"
            android:paddingTop="9dp"
            android:paddingEnd="4dp"
            android:paddingBottom="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_drawer_search_rail" />

        <ImageView
            android:id="@+id/searchActionBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_mode_enable"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_drawer_action_badge"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
