    <string name="welcome_to_olauncher_settings">ברוכים הבאים להגדרות!\n\nזכרו, אם יש לכם שאלות, בעמוד \"מידע כללי\" שלנו נמצאת התשובה.</string>
    <string name="rate_us_message">היי, לא תראו הודעה זו שוב.\n\nאם Olauncher מועיל לכם, האם תוכלו להשאיר ביקורת של 5 כוכבים? זה יעזור לנו מאוד. תודה!</string>
    <string name="share_message">אנחנו זקוקים לעזרתכם! אנו מאמינים שכולם צריכים להכיר את Olauncher ואת יתרונותיו, אבל אנחנו לא יכולים לעשות זאת לבד.\n\nהאם תוכלו לשתף את Olauncher עם החברים, המשפחה והעוקבים שלכם? תודה על התמיכה! ❤</string>
    <string name="keyboard_message">היי, המקלדת היא הדרך המהירה ביותר למצוא ולפתוח יישומים ב־Olauncher. האם נוכל לבקש מכם להשאיר את ההגדרה הזאת פעילה עוד כמה ימים ואז להחליט?\n\nהבחירה תמיד שלכם.</string>
    <string name="wallpaper_message">Olauncher מציע טפטים חדשים ויפים מדי יום. תנו למסך הבית שלכם מראה חדש ורענן בכל יום, בחינם!\n\nרוצים לנסות?</string>
    <string name="accessibility_service_description">הרשאת הנגישות נחוצה להפעלת המחווה של נעילה בהקשה כפולה. כל הנתונים שייאספו על ידי Olauncher דרך שירות זה לא יעזבו את המכשיר שלכם.</string>
    <string name="support_olauncher_for_free">אפשר לתמוך ב־Olauncher מבלי לשלם שקל, בעזרת שימוש בקישור ה־Amazon affiliate שלנו.</string>
    <string name="support_olauncher_message">על כל רכישה שתבוצע דרך הקישור שלנו אנחנו נקבל עמלה קטנה. נשמח אם תשמרו את הקישור ותשתמשו בו בקניות מהאינטרנט.\nתודה רבה!</string>
